# KR8 Digitals - Environment Variables
# Copy to .env and fill values. Set same vars in Vercel Dashboard -> Settings -> Environment Variables
# NEVER commit .env with real secrets

# === Supabase ===
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# === Site URL ===
VITE_SITE_URL=
SITE_URL=

# === LiveKit ===
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VITE_LIVEKIT_URL=
VITE_LIVEKIT_API_KEY=

# === Resend ===
RESEND_API_KEY=
RESEND_FROM=

# === Build ===
NITRO_PRESET=

# Notes:
# - SERVICE_ROLE_KEY, LIVEKIT_API_SECRET, RESEND_API_KEY must stay server-side (no VITE_ prefix)
# - VITE_ prefixed vars are exposed to client
# - Set all vars in Vercel for production
